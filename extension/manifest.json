{
  "manifest_version": 3,
  "name": "自带 Token 沉浸翻译",
  "description": "使用你自己的 DeepSeek 或 OpenAI-compatible API，在网页原文下方显示译文。",
  "version": "0.2.0",
  "minimum_chrome_version": "102",
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "16.4"
    }
  },
  "icons": {
    "16": "assets/brand/icon-16.png",
    "32": "assets/brand/icon-32.png",
    "48": "assets/brand/icon-48.png",
    "128": "assets/brand/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.mjs",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "assets/brand/icon-16.png",
      "32": "assets/brand/icon-32.png",
      "48": "assets/brand/icon-48.png",
      "128": "assets/brand/icon-128.png"
    },
    "default_popup": "src/popup/popup.html",
    "default_title": "翻译当前页面"
  },
  "commands": {
    "toggle-translation": {
      "suggested_key": "Alt+A",
      "description": "开始翻译，或在原文与译文之间切换"
    },
    "translate-whole-page": {
      "suggested_key": "Alt+W",
      "description": "翻译整个页面"
    }
  },
  "options_page": "src/options/options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/*.mjs",
        "src/shared/*.mjs"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
